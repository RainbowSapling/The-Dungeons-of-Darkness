        <mxCell id="bVKxj864shOD7K9TONzq-2" parent="bVKxj864shOD7K9TONzq-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 80px;&quot;&gt;Forest / River&lt;/font&gt;" vertex="1">
